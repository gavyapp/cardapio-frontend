# Copie para .env.local e preencha com os valores do projeto Supabase de dev.
# Supabase > Project Settings > API (ou `npx supabase status` no ambiente local).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor: ignora o RLS. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
# Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...
