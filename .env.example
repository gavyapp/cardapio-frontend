# Copie para .env.local e preencha com os valores do projeto Supabase de dev.
# Supabase > Project Settings > API (ou `npx supabase status` no ambiente local).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domínio raiz em produção. O cardápio de cada loja fica em <slug>.<domínio>
# e o painel em painel.<domínio>; o src/proxy.ts reescreve para /<slug> e
# /painel. Em desenvolvimento, *.localhost:3000 funciona sem configurar nada.
NEXT_PUBLIC_ROOT_DOMAIN=gavy.com

# Nome da plataforma mostrado no painel.
NEXT_PUBLIC_PLATFORM_NAME=Gavy

# Só no servidor: ignora o RLS. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
# Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...
